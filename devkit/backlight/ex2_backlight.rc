# ex2_backlight.rc — init service คุม backlight ให้ EX2 BY OAKHEN (วางที่ /system/etc/init/)
# รัน daemon เป็น root (su domain = เขียน sysfs_leds ได้) หลังบูตเสร็จ
service ex2_bl /system/bin/sh /system/etc/ex2_backlight.sh
    class late_start
    user root
    group root system
    seclabel u:r:su:s0

on property:sys.boot_completed=1
    start ex2_bl
